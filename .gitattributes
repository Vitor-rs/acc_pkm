# Auto-detect text files and normalize line endings to LF on commit
* text=auto eol=lf

# Explicitly ensure Windows scripts keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# LaTeX, Markdown and Academic Data
*.tex text eol=lf diff=tex
*.bib text eol=lf
*.md text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.py text eol=lf
*.html text eol=lf

# Binaries
*.pdf binary
*.epub binary
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
