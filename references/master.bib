@article{Asl2025_FairragFaithful,
  title = {FAIR-RAG: Faithful Adaptive Iterative Refinement for Retrieval-Augmented Generation},
  author = {Mohammad Aghajani Asl and Majid Asgari-Bidhendi and Behrooz Minaei-Bidgoli},
