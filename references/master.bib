@article{Gao2023_RetrievalaugmentedGeneration,
  title = {Retrieval-Augmented Generation for Large Language Models: A Survey},
  author = {Yunfan Gao and Yun Xiong and Xinyu Gao and Kangxiang Jia and Jinliu Pan and Yuxi Bi and Yi Qi Dai and Jiawei Sun and Wang, Meng and Wang, Haofen},
