{
  "latex-workshop.latex.outDir": "%DIR%/build",
  "latex-workshop.view.pdf.viewer": "tab",
  "latex-workshop.latex.autoBuild.run": "onSave",
  "latex-workshop.latex.tools": [
    {
      "name": "latexmk",
      "command": "latexmk",
      "args": [
        "-synctex=1",
        "-interaction=nonstopmode",
        "-file-line-error",
        "-pdf",
        "-pdflatex=pdflatex -synctex=1 -interaction=nonstopmode --enable-installer",
        "-outdir=%DIR%/build",
        "%DOC%"
      ],
      "env": {
        "PATH": "C:\\Program Files\\Git\\usr\\bin;${env:PATH}"
      }
    },
    {
      "name": "xelatexmk",
      "command": "latexmk",
      "args": [
        "-synctex=1",
        "-interaction=nonstopmode",
        "-file-line-error",
        "-xelatex",
        "-outdir=%DIR%/build",
        "%DOC%"
      ],
      "env": {
        "PATH": "C:\\Program Files\\Git\\usr\\bin;${env:PATH}"
      }
    },
    {
      "name": "pdflatex",
      "command": "pdflatex",
      "args": [
        "-synctex=1",
        "-interaction=nonstopmode",
        "-file-line-error",
        "--enable-installer",
        "-output-directory=%DIR%/build",
        "%DOC%"
      ],
      "env": {
        "PATH": "C:\\Program Files\\Git\\usr\\bin;${env:PATH}"
      }
    },
    {
      "name": "bibtex",
      "command": "bibtex",
      "args": [
        "%DIR%/build/%DOCFILE%"
      ],
      "env": {
        "PATH": "C:\\Program Files\\Git\\usr\\bin;${env:PATH}"
      }
    },
    {
      "name": "biber",
      "command": "biber",
      "args": [
        "--input-directory=%DIR%",
        "--output-directory=%DIR%/build",
        "%DOCFILE%"
      ],
      "env": {
        "PATH": "C:\\Program Files\\Git\\usr\\bin;${env:PATH}"
      }
    }
  ],
  "latex-workshop.latex.recipes": [
    {
      "name": "latexmk (default)",
      "tools": [
        "latexmk"
      ]
    },
    {
      "name": "pdflatex -> bibtex -> pdflatex*2",
      "tools": [
        "pdflatex",
        "bibtex",
        "pdflatex",
        "pdflatex"
      ]
    },
    {
      "name": "xelatexmk",
      "tools": [
        "xelatexmk"
      ]
    },
    {
      "name": "pdflatex -> biber -> pdflatex*2",
      "tools": [
        "pdflatex",
        "biber",
        "pdflatex",
        "pdflatex"
      ]
    }
  ],
  "latex-workshop.intellisense.citation.backend": "bibtex",
  "latex-workshop.latex.bibDirs": [
    "${workspaceFolder}/references"
  ],
  "latex-workshop.latex.clean.subfolder.enabled": true,
  "latex-workshop.latex.clean.fileTypes": [
    "*.aux",
    "*.bbl",
    "*.blg",
    "*.idx",
    "*.ind",
    "*.lof",
    "*.lot",
    "*.out",
    "*.toc",
    "*.acn",
    "*.acr",
    "*.alg",
    "*.glg",
    "*.glo",
    "*.gls",
    "*.fls",
    "*.log",
    "*.fdb_latexmk",
    "*.snm",
    "*.nav",
    "*.synctex.gz"
  ],
  "ltex.language": "pt-BR",
  "ltex.additionalRules.enablePickyRules": true,
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/Scripts/python.exe",
  "files.associations": {
    "*.tex": "latex",
    "*.bib": "bibtex",
    "*.cls": "latex",
    "*.sty": "latex"
  }
}
