{
  "latex-workshop.latex.outDir": "%DIR%/build",
  "latex-workshop.view.pdf.viewer": "tab",
  "latex-workshop.latex.autoBuild.run": "onSave",
  "latex-workshop.latex.tools": [
    {
      "name": "latexmk",
      "command": "latexmk",
      "args": [
        "-synctex=1",
        "-interaction=nonstopmode",
        "-file-line-error",
        "-pdf",
        "-pdflatex=pdflatex -synctex=1 -interaction=nonstopmode --enable-installer",
        "-outdir=%DIR%/build",
        "%DOC%"
      ],
      "env": {
        "PATH": "C:\\Program Files\\Git\\usr\\bin;${env:PATH}"
      }
    },
    {
      "name": "xelatexmk",
      "command": "latexmk",
      "args": [
        "-synctex=1",
        "-interaction=nonstopmode",
        "-file-line-error",
        "-xelatex",
        "-outdir=%DIR%/build",
        "%DOC%"
      ],
      "env": {
        "PATH": "C:\\Program Files\\Git\\usr\\bin;${env:PATH}"
      }
    },
    {
      "name": "pdflatex",
      "command": "pdflatex",
      "args": [
        "-synctex=1",
        "-interaction=nonstopmode",
        "-file-line-error",
        "--enable-installer",
        "-output-directory=%DIR%/build",
        "%DOC%"
      ],
      "env": {
        "PATH": "C:\\Program Files\\Git\\usr\\bin;${env:PATH}"
      }
    },
    {
      "name": "bibtex",
      "command": "bibtex",
      "args": [
        "%DIR%/build/%DOCFILE%"
      ],
      "env": {
        "PATH": "C:\\Program Files\\Git\\usr\\bin;${env:PATH}"
      }
    },
    {
      "name": "biber",
      "command": "biber",
      "args": [
        "--input-directory=%DIR%",
        "--output-directory=%DIR%/build",
        "%DOCFILE%"
      ],
      "env": {
        "PATH": "C:\\Program Files\\Git\\usr\\bin;${env:PATH}"
      }
    }
  ],
  "latex-workshop.latex.recipes": [
    {
      "name": "latexmk (default)",
      "tools": [
        "latexmk"
      ]
    },
    {
      "name": "pdflatex -> bibtex -> pdflatex*2",
      "tools": [
        "pdflatex",
        "bibtex",
        "pdflatex",
        "pdflatex"
      ]
    },
    {
      "name": "xelatexmk",
      "tools": [
        "xelatexmk"
      ]
    },
    {
      "name": "pdflatex -> biber -> pdflatex*2",
      "tools": [
        "pdflatex",
        "biber",
        "pdflatex",
        "pdflatex"
      ]
    }
  ],
  "latex-workshop.intellisense.citation.backend": "bibtex",
  "latex-workshop.latex.bibDirs": [
    "${workspaceFolder}/references"
  ],
  "latex-workshop.latex.clean.subfolder.enabled": true,
  "latex-workshop.latex.clean.fileTypes": [
    "*.aux",
    "*.bbl",
    "*.blg",
    "*.idx",
    "*.ind",
    "*.lof",
    "*.lot",
    "*.out",
    "*.toc",
    "*.acn",
    "*.acr",
    "*.alg",
    "*.glg",
    "*.glo",
    "*.gls",
    "*.fls",
    "*.log",
    "*.fdb_latexmk",
    "*.snm",
    "*.nav",
    "*.synctex.gz"
  ],
  "ltex.language": "pt-BR",
  "ltex.additionalRules.enablePickyRules": true,
  "python.defaultInterpreterPath": "C:\\Users\\user\\AppData\\Roaming\\uv\\python\\cpython-3.13.11-windows-x86_64-none\\python.exe",
  "python.envFile": "${workspaceFolder}/.env",
  "python.terminal.useEnvFile": true,
  "workbench.editorAssociations": {
    "*.pdf": "latex-workshop-pdf-hook"
  },
  "workbench.tree.indent": 18,
  "workbench.tree.renderIndentGuides": "always",
  "explorer.compactFolders": false,
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.expand": false,
  "explorer.fileNesting.patterns": {
    "*.tex": "${capture}.pdf, ${capture}.aux, ${capture}.bbl, ${capture}.blg, ${capture}.log, ${capture}.out, ${capture}.toc, ${capture}.lof, ${capture}.lot, ${capture}.fls, ${capture}.fdb_latexmk, ${capture}.synctex.gz, ${capture}.nav, ${capture}.snm, ${capture}.vrb",
    "*.py": "${capture}.pyi, ${capture}.pyc",
    "pyproject.toml": "uv.lock, requirements.txt, .python-version",
    "README.md": "AGENTS.md, GEMINI.md, LICENSE*"
  },
  "files.exclude": {
    "**/.git": true,
    "**/.svn": true,
    "**/.hg": true,
    "**/CVS": true,
    "**/.DS_Store": true,
    "**/Thumbs.db": true,
    "**/__pycache__": true,
    "**/.pytest_cache": true,
    "**/*.pyc": true
  },
  "search.exclude": {
    "**/.git": true,
    "**/.venv": true,
    "**/build": true,
    "**/__pycache__": true
  },
  "workbench.colorCustomizations": {
    "statusBar.background": "#075985",
    "statusBar.foreground": "#f0f9ff",
    "statusBar.debuggingBackground": "#0369a1",
    "tree.indentGuidesStroke": "#38bdf888"
  },
  "files.associations": {
    "*.tex": "latex",
    "*.bib": "bibtex",
    "*.cls": "latex",
    "*.sty": "latex"
  }
}
